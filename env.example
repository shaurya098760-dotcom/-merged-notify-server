# Render ke "Environment" tab me ye 4 variables add karne hain
# (local testing ke liye .env banao, Render pe .env upload NAHI karna)

# FireXBattle project (zap-webhook + arenax-notify-server + refer-system
# teeno isi ek service-account ko use karte the — same JSON yahan paste karo)
FIREX_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...", ...}

# Shubh Sankalp project ka service-account JSON (alag Firebase project)
SHUBH_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...", ...}

# ATC project ka service-account JSON (alag Firebase project)
ATC_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...", ...}

# Admin panel ke "Send to All Users" ke liye same key jo pehle
# arenax-notify-server me NOTIFY_ADMIN_API_KEY use hota tha
ADMIN_API_KEY=apna-purana-wala-key-yahan-daalo
